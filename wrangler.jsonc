{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "xingji-flights",
  "main": "cloud/worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "send_metrics": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "xingji-flights",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "cloud/migrations"
  }],
  "vars": {
    "AUTH_MODE": "password",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    "OWNER_EMAIL": "you@example.com",
    "APP_ORIGIN": ""
  },
  "triggers": {"crons": ["0 * * * *"]},
  "observability": {"enabled": false}
}
